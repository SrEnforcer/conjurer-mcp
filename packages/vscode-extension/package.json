{
  "name": "conjurer-mcp",
  "displayName": "Conjurer",
  "description": "Inline spec access for .cnj authors — hover docs, CodeLens, validation, and folder materialisation.",
  "version": "0.3.0",
  "publisher": "conjurer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SrEnforcer/conjurer-mcp"
  },
  "categories": [
    "Other"
  ],
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "node": ">=20.0.0",
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "workspaceContains:**/*.cnj"
  ],
  "contributes": {
    "languages": [
      {
        "id": "conjurer",
        "aliases": [
          "Conjurer",
          "cnj"
        ],
        "extensions": [
          ".cnj"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "conjurer.lookupSymbol",
        "title": "Conjurer: Look up symbol"
      },
      {
        "command": "conjurer.searchSymbols",
        "title": "Conjurer: Search symbols"
      },
      {
        "command": "conjurer.validateCnj",
        "title": "Conjurer: Validate current .cnj"
      },
      {
        "command": "conjurer.showOpen",
        "title": "Conjurer: Show open questions"
      },
      {
        "command": "conjurer.materialiseFolder",
        "title": "Conjurer: Materialise folder"
      },
      {
        "command": "conjurer.refineForm",
        "title": "Conjurer: Refine form with AI"
      },
      {
        "command": "conjurer.resolveOpenQuestions",
        "title": "Conjurer: Resolve open questions with AI"
      },
      {
        "command": "conjurer.describeSymbol",
        "title": "Conjurer: Describe symbol"
      }
    ],
    "configuration": {
      "title": "Conjurer",
      "properties": {
        "conjurer.promptTarget": {
          "type": "string",
          "enum": [
            "vscodeChat",
            "claudeCode",
            "clipboard"
          ],
          "enumDescriptions": [
            "VS Code's built-in chat view (GitHub Copilot Chat).",
            "A new Claude Code tab with the prompt in its input box, not yet sent: review it and press Enter. Needs the Claude Code extension.",
            "Copy the prompt to the clipboard, to paste into any chat."
          ],
          "default": "vscodeChat",
          "markdownDescription": "Where the AI-assisted commands (**Refine form with AI**, **Resolve open questions with AI** and the candidate and goal commands) send the prompt they build. If the chosen chat cannot be opened, the prompt is copied to the clipboard instead."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "conjurer.describeSymbol",
          "when": "editorLangId == conjurer || resourceExtname == .cnj",
          "group": "conjurer@1"
        }
      ],
      "explorer/context": [
        {
          "command": "conjurer.materialiseFolder",
          "when": "explorerResourceIsFolder",
          "group": "conjurer@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm run build:prod",
    "build:dev": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=esm --target=node20",
    "build:prod": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=esm --target=node20 --minify",
    "package": "pnpm run build:prod && vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@conjurer/core": "workspace:*",
    "@tsfpp/prelude": "^2.5.0"
  },
  "devDependencies": {
    "@tsfpp/eslint-config": "^2.1.0",
    "@tsfpp/standard": "^5.0.1",
    "@tsfpp/tsconfig": "^1.0.0",
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
