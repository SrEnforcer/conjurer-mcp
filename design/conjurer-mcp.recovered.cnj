  :enforces [
    "Base TSF++ standard from spec/CODING_STANDARD.md applies to all TypeScript source"
    "Profile standards apply by scope (API, React, Data, Config, Log, Test, Annotation, Security)"
    "TSF++/Test and TSF++/Annotate profiles are cross-cutting"
    "Deviation handling follows the normative procedure defined in the standard package"]
  :prohibits [
    "Project-local redefinition of coding standard outside @tsfpp/standard"
    "Undocumented divergence from normative TSF++ rules and profiles"]
  :applies-to [:mcp-server]
  :active-in :project)

