;;; conjurer-mcp.recovered.cnj
;;; Recovered baseline synthesized from ../conjurer-mcp.
;;; Confidence legend used in decisions:
;;;   :attested           - directly evidenced in source/config/docs
;;;   :strongly-inferred  - highly supported but not explicitly stated as intent
;;;   :speculative        - plausible but insufficiently evidenced; moved to :open

(charter "conjurer-mcp (recovered baseline)"
  :version "0.0.0-recovered"
  :created "2026-06-06"
  :updated "2026-06-06"
  :domain "A TypeScript Model Context Protocol server for Conjurer that provides symbol routing, grimoire retrieval, workspace .cnj context services, dependency-aware resolve/evaluate flows, and stdio plus Streamable HTTP transports."
  :language :en

  :goals [
    "Serve targeted Conjurer specification context to MCP clients without requiring full-spec loading on every call."
    "Support deterministic workflow tools for parse, resolve, evaluate, explain, and topology analysis, with project-aware dependency/caching behavior preserved."
    "Maintain workspace-aware .cnj state, dependency graphs, unresolved diagnostics, and stale artifact visibility."
    "Recover and preserve declared versus enforced stack rules for dependencies, runtime, build, and linting policy."
    "Package as a local-first Node CLI (npx conjurer-mcp) with bundled conjurer-spec assets and optional workspace integration."
    "Keep implementation testable with extensive TypeScript unit tests across services and runtime glue."]

  :audience {:primary :engineer
             :secondary [:tooling-engineer :ai-agent-developer]}

  :decisions [
    {:date "2026-06-06"
     :decision "Implemented as a TypeScript MCP server using @modelcontextprotocol/sdk with zod-based tool schemas and explicit runtime registration."
     :recovered :attested
    :evidence ["../conjurer-mcp/package.json dependencies include @modelcontextprotocol/sdk and zod"
         "../conjurer-mcp/src/index/server-runtime.ts imports McpServer and registers tools"]}
    {:date "2026-06-06"
     :decision "Support both local stdio and hosted Streamable HTTP transports."
     :recovered :attested
    :evidence ["../conjurer-mcp/package.json scripts include start and start:http"
         "../conjurer-mcp/src/http-bridge.ts wires StreamableHTTPServerTransport and /mcp route"]}
    {:date "2026-06-06"
     :decision "Bundle conjurer-spec into assets for distributable CLI execution, while still allowing skill-path overrides."
     :recovered :attested
    :evidence ["../conjurer-mcp/package.json build script runs bundle:spec copying node_modules/conjurer-spec"
         "../conjurer-mcp/README.md documents --skill-path override"]}
    {:date "2026-06-06"
     :decision "Adopt workspace-level context parsing and dependency-aware evaluation with cache invalidation based on context fingerprints."
     :recovered :attested
    :evidence ["../conjurer-mcp/src/services/workspace-context-service.ts defines computeCacheKey and stale artifact tracking"
         "../conjurer-mcp/README.md tool/resource list includes resolve/evaluate, dependency graph, unresolved diagnostics"]}
    {:date "2026-06-06"
     :decision "Use functional Result/Option style pervasively with controlled boundary deviations in adapter layers."
     :recovered :strongly-inferred
    :evidence ["../conjurer-mcp/src/index/server-runtime.ts and ../conjurer-mcp/src/http-bridge.ts use @tsfpp/prelude and Result/Option flow"
         "../conjurer-mcp/DEVIATIONS.md and DEVIATION markers document intentional boundary exceptions"]}
    {:date "2026-06-06"
     :decision "Evolve from an earlier imperfect architecture toward modularized services and verification-heavy development."
     :recovered :strongly-inferred
    :evidence ["../conjurer-mcp/docs/improvement.plan.md and ../conjurer-mcp/design/improvement.plan.v2.md capture staged improvement intent"
          "../conjurer-mcp/src layout split across services, index helpers, parser, and tests"]}
        {:date "2026-06-06"
      :decision "Keep project-aware workspace context, dependency graphing, resolve/evaluate planning, and cache invalidation behavior as core functionality."
      :recovered :attested
        :evidence ["../conjurer-mcp/src/services/workspace-context-service.ts and related tests"
          "../conjurer-mcp/README.md documents resolve/evaluate, dependency graph, unresolved diagnostics"]}
        {:date "2026-06-06"
      :decision "Do not embed an LLM in the MCP server at this stage; generation/materialization intelligence remains in the local IDE agent."
      :recovered :attested
        :evidence ["Practitioner direction on 2026-06-06 for this recovery"
          "../conjurer-mcp/README.md positions server as deterministic tooling layer"]}
        {:date "2026-06-06"
      :decision "Architecture direction for next materialization: keep server-centric design manifests in src/ and place VSIX extension implementation under packages/."
      :recovered :attested
        :evidence ["Practitioner direction on 2026-06-06 for this recovery"]}]

  :open [
    "Which prior features are required for parity versus candidates for deprecation in this new materialization?"
    "Should HTTP transport remain first-class in the next design iteration or become an optional package/module?"
    "Is the current workspace context service too broad and in need of bounded-context splits before further feature growth?"
    "What rationale drove specific deviation rules and thresholds historically? (partially unreconstructable from current evidence)"
    "How should legacy .ai compatibility expectations documented in ../conjurer-mcp/ai.md influence this repository's customization layout?"
    "If materialise/rewrite capabilities are retained, what strictly deterministic boundary should they have without introducing an in-server LLM?"
    "When a future decision requires in-server LLM support, what explicit trigger criteria would justify changing the no-LLM constraint?"]

  :outputs {
    :mcp-server (target :typescript :standard :team-standard)
    :stack-report :conjurer-only
    :recovery-report :conjurer-only}

  :references [
    "../conjurer-mcp/README.md"
    "../conjurer-mcp/package.json"
    "../conjurer-mcp/ai.md"
    "../conjurer-mcp/DEVIATIONS.md"
    "../conjurer-mcp/docs/improvement.plan.md"
    "../conjurer-mcp/design/improvement.plan.v2.md"
    "../conjurer-mcp/src/index/server-runtime.ts"
    "../conjurer-mcp/src/http-bridge.ts"
    "../conjurer-mcp/src/services/workspace-context-service.ts"
    "../conjurer-mcp/docs/mcp-design-requirements.md"
    "https://www.npmjs.com/package/@tsfpp/eslint-config"
    "https://www.npmjs.com/package/@tsfpp/tsconfig"
    "https://www.npmjs.com/package/@tsfpp/standard"]
  :tags [:recovered :mcp :typescript :conjurer :workspace-context])

