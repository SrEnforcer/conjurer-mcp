(f/candidate :cnj_resources
  :label   ".cnj MCP resources"
  :cluster :cluster-resources
  :added   "2026-06-09"
  :status  :proposed
  :scores  {:feasibility 7 :elegance 8 :containment 9 :value 7}
  :conditions ["Name one concrete IDE workflow (hover, reference navigation, diff view)
                that demonstrably benefits from subscribing to .cnj resources rather than
                calling parse_cnj on demand — weak use cases don't justify a new public
                URI surface."
               "Decide the URI key before writing any code: basename
                (conjurer://cnj/mcp-server) vs. workspace-relative path
                (conjurer://cnj/design/mcp-server) — the URI is public protocol API
                and cannot be changed without breaking callers."]
  :rationale "Expose workspace .cnj files as conjurer://cnj/<name> MCP resources
              alongside the existing grimoire resources — enables the IDE to
              subscribe and browse the design layer without a dedicated tool call.
              Small surface; grimoires already show the pattern works. Deferred:
              not blocking any current IDE workflow; cosmetic until we add
              change-notification support.")

(f/candidate :snapshot_workspace
  :label   "snapshot_workspace"
  :cluster :cluster-d
  :added   "2026-06-09"
  :status  :proposed
  :scores  {:feasibility 8 :elegance 7 :containment 8 :value 7}
  :history [(f/reassess :of :snapshot_workspace
               :date      "2026-10-14"
               :scores    {:elegance 6 :value 4}
               :rationale "Since this was proposed, its claimed uses have been absorbed by built
                           tools: diff_cnj and diff_candidates cover diffing state over time (git
                           supplies the baseline), and workspace_summary, lens_dependency_graph,
