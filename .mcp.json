{
  "mcpServers": {
    "conjurer-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "packages/mcp-server/dist/server.js"
      ],
      "env": {}
    },
    "tsfpp-mcp-server": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "tsx",
        "node_modules/@tsfpp/mcp-server/bin/tsfpp-mcp.ts"
      ],
      "env": {}
    }
  }
}