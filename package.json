{
  "name": "conjurer-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter @conjurer/core build && pnpm -r --filter !@conjurer/core build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check:design": "pnpm --filter @conjurer/mcp-server check:design"
  },
  "devDependencies": {
    "@tsfpp/agents": "^1.9.0",
    "@tsfpp/mcp-server": "^1.0.1",
    "@tsfpp/standard": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
