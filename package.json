    "test": "pnpm -r test",
    "check:design": "pnpm --filter @conjurer/mcp-server check:design"
  },
  "devDependencies": {
    "@tsfpp/agents": "^2.6.0",
    "@tsfpp/mcp-server": "^1.0.4",
    "@tsfpp/standard": "^5.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
