{
  "name": "conjurer-mcp",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter @conjurer/core build && pnpm -r --filter !@conjurer/core build",
    "typecheck": "pnpm -r typecheck",
